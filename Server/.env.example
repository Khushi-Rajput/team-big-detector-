# ==============================================================================
# AI RESUME ANALYZER - BACKEND ENVIRONMENT CONFIGURATION (.env)
# ==============================================================================

# Server & Runtime Environment
PORT=5000
FLASK_ENV=production
FLASK_DEBUG=0
SECRET_KEY=c8f49b28a9e70192df48301ec9b83a71b2d3e4f5a6b7c8d9e0f1a2b3c4d5e6f7

# Primary AI Provider: Google Gemini API (Recommended - Ultra-fast & High Free Quotas)
# Get your free key at: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-1.5-flash

# Secondary AI Provider: OpenAI API (Optional Fallback)
# Get your key at: https://platform.openai.com/api-keys
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-4o-mini

# Database Configuration (Defaults to embedded high-performance SQLite)
DB_TYPE=sqlite
DB_NAME=ats_analyzer.db

# Legacy MySQL Configuration (Only required if connecting to a MySQL server)
DB_HOST=127.0.0.1
DB_USER=root
DB_PASSWORD=your_mysql_password_here
DB_PORT=3306
